# Mapbox Public Access Token (Get free from https://account.mapbox.com)
# Used for 3D building extrusions and satellite/vector basemaps on frontend
MAPBOX_ACCESS_TOKEN=pk.eyJ1IjoiZXhhbXBsZSIsImEiOiJjbGV4YW1wbGUwMDAwMG1wZGV4YW1wbGUwIn0.example

# Server Settings
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*
DEBUG=True

# Database (Optional PostgreSQL/PostGIS; if unset, RESQ uses optimized in-memory/JSON storage)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resq_db

# Redis Cache (Optional; falls back to in-memory event bus and caching)
REDIS_URL=redis://localhost:6379/0

# OpenStreetMap Services (Optional external API overrides)
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org

# AI Decision Support (Optional: Google Gemini API Key for dynamic neural sitreps)
AI_API_KEY=
GEMINI_API_KEY=
